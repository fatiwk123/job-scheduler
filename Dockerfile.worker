FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY shared/ shared/
COPY worker/ worker/
RUN useradd --create-home app && mkdir -p /data/outputs && chown app /data/outputs
USER app
# SIGTERM -> le worker termine sa tache en cours puis s'arrete proprement.
STOPSIGNAL SIGTERM
CMD ["python", "-m", "worker.worker"]
